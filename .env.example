# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# Database Configuration
# ⚠️  IMPORTANT: For Railway deployments, do NOT use localhost
# Railway will auto-populate DATABASE_URL when PostgreSQL plugin is linked
# Format: postgresql://user:password@host:5432/database_name
DATABASE_URL=postgresql://user:password@localhost:5432/tts_db

# Hugging Face Hub Configuration (optional but recommended)
# Get token from: https://huggingface.co/settings/tokens
# Enables higher rate limits and faster model downloads for TTS
HF_TOKEN=your_huggingface_token_here
