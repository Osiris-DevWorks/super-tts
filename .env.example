# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
OWNER_ID=your_discord_id_here

# Database Configuration
# ⚠️  IMPORTANT: For Railway deployments, do NOT use localhost
# Railway will auto-populate DATABASE_URL when PostgreSQL plugin is linked
# Format: postgresql://user:password@host:5432/database_name
DATABASE_URL=postgresql://user:password@localhost:5432/tts_db

# Individual database components (optional if using DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=tts_db

# TTS Configuration
TTS_DEFAULT_VOICE=custom
TTS_DEVICE=auto  # auto, cuda, rocm, cpu
TTS_MAX_CONCURRENT=6

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/tts_bot.log

# Bot Settings
PREFIX=/
BOT_ACTIVITY_NAME=Supertonic TTS
BOT_ACTIVITY_TYPE=playing
